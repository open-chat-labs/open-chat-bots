# The port the bot listens on. OpenChat registers the bot at this origin and opens `<origin>/app`.
PORT=3100

# OpenChat's public key, from the UserIndex's `public_key`. Literal `\n`s are unescaped.
OC_PUBLIC="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# The IC the bot talks to: http://127.0.0.1:8080 for a local replica, https://icp-api.io for mainnet
IC_HOST=http://127.0.0.1:8080

# The bot's identity, a secp256k1 private key in PEM, as `dfx identity export <name>` prints it
IDENTITY_PRIVATE="-----BEGIN EC PRIVATE KEY-----\n...\n-----END EC PRIVATE KEY-----"

# OpenChat's StorageIndex canister, for card images (none are uploaded yet)
STORAGE_INDEX_CANISTER=rturd-qaaaa-aaaaf-aabaq-cai

# OpenChat's UserIndex, which players' names are looked up from. Optional: mainnet's if not set.
USER_INDEX_CANISTER=

# OpenChat's MiniApp service, which posts the cards and relays the games' state
MINI_APP_SERVICE_URL=http://localhost:8095

# A LocalUserIndex the bot gets its MiniApp service token from. Optional: the bot remembers the
# LocalUserIndex of the last command it got, so this only matters before its first command.
OC_API_GATEWAY=

# Where the games are kept between restarts. Optional: ./data/games.json if not set.
DATA_FILE=./data/games.json
