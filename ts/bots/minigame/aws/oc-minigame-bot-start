#!/bin/sh
# Starts MiniGameBot on its EC2 host, for the systemd unit `oc-minigame-bot`, installed as
# /usr/local/bin/oc-minigame-bot-start: pulls the image `oc-minigame-bot:latest` from ECR, writes the
# config from SSM Parameter Store's /oc-minigame-bot/* to /run, readable only by root, and runs the
# image with it. Its port, 3100 in the container, is 8084 on the host, as 8080 to 8083 are the
# bridges', the price service's and the MiniApp service's. Its games are kept in
# /var/lib/oc-minigame-bot, so a restart or a deploy doesn't end them. Logs go to CloudWatch, in
# /oc/minigame-bot, which is made beforehand.
set -eu
umask 077
REGION=us-east-1
IMAGE=253040722768.dkr.ecr.us-east-1.amazonaws.com/oc-minigame-bot:latest
DIR=/run/oc-minigame-bot
DATA=/var/lib/oc-minigame-bot

aws ecr get-login-password --region "$REGION" | docker login --username AWS --password-stdin "${IMAGE%%/*}"
docker pull "$IMAGE"

get() {
    aws ssm get-parameter --region "$REGION" --with-decryption --name "/oc-minigame-bot/$1" \
        --query Parameter.Value --output text
}
mkdir -p "$DIR"
# The keys span lines, so they're passed as values of their own rather than in the env file
get IDENTITY_PRIVATE > "$DIR/IDENTITY_PRIVATE"
get OC_PUBLIC > "$DIR/OC_PUBLIC"
{
    echo "IC_HOST=https://icp-api.io"
    echo "STORAGE_INDEX_CANISTER=rturd-qaaaa-aaaaf-aabaq-cai"
    echo "MINI_APP_SERVICE_URL=$(get MINI_APP_SERVICE_URL)"
} > "$DIR/env"

# The image runs as `node`, uid 1000, which writes the games
mkdir -p "$DATA"
chown 1000:1000 "$DATA"

exec docker run --rm --name oc-minigame-bot \
    --env-file "$DIR/env" \
    -e IDENTITY_PRIVATE="$(cat "$DIR/IDENTITY_PRIVATE")" \
    -e OC_PUBLIC="$(cat "$DIR/OC_PUBLIC")" \
    -v "$DATA":/data \
    -p 8084:3100 \
    --log-driver awslogs \
    --log-opt awslogs-region="$REGION" \
    --log-opt awslogs-group=/oc/minigame-bot \
    "$IMAGE"
