{
    "compilerOptions": {
        "target": "ES2022",
        "module": "commonjs",
        "lib": ["ES2022"],
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "rootDir": "./src",
        "outDir": "./dist/server",
        "types": ["node"]
    },
    "include": ["src/**/*"],
    "exclude": ["node_modules", "src/app", "src/**/*.spec.ts"]
}
